# ═══════════════════════════════════════
# Mörkrets Rike — Backend Environment
# ═══════════════════════════════════════
# DENNA FIL SKA ALDRIG COMMITTAS!
# Kopiera till .env och fyll i riktiga nycklar.

# ── Qwen (DashScope / Alibaba Token Plan) ──
DASHSCOPE_API_KEY=sk-xxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.8-max

# ── DeepSeek ──
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── MiMo (Xiaomi) ──
MIMO_API_KEY=xxxxx
MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1

# ── Ollama (lokal, ingen nyckel) ──
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Auth ──
JWT_SECRET=byt-mig-till-nagot-langt-och-slumpmassigt
JWT_EXPIRY_HOURS=24

# ── Server ──
HOST=0.0.0.0
PORT=8090
