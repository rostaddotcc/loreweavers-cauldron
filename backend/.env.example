# ═══════════════════════════════════════
# The Lore Weaver's Cauldron — Backend Environment
# ═══════════════════════════════════════
# DENNA FIL SKA ALDRIG COMMITTAS!
# Kopiera till .env och fyll i riktiga nycklar.
#
# Docker: docker compose up -d (läser denna fil automatiskt)

# ── Admin-konto ──
# Skapas automatiskt vid första start om det inte finns.
# Ändra lösenordet i data/users.json (bcrypt-hash).
ADMIN_USER=admin
ADMIN_PASSWORD=***

# ── Qwen (DashScope / Alibaba Token Plan) ──
DASHSCOPE_API_KEY=***
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.8-max

# ── DeepSeek ──
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── MiMo (Xiaomi) ──
MIMO_API_KEY=***
MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1

# ── Ollama (lokal, ingen nyckel) ──
# Kör du Ollama i Docker på samma nät: http://ollama:11434/v1
# Kör du Ollama på hosten: http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Auth ──
JWT_SECRET=byt-mig-till-nagot-langt-och-slumpmassigt
JWT_EXPIRY_HOURS=24

# ── Server ──
HOST=0.0.0.0
PORT=8090
