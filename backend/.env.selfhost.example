# ═══════════════════════════════════════
# The Lore Weaver's Cauldron — self-host environment
# ═══════════════════════════════════════
# Copy this file to backend/.env.selfhost and fill in the three required
# values. Never commit backend/.env.selfhost.
#
#   cp backend/.env.selfhost.example backend/.env.selfhost
#   # edit ADMIN_PASSWORD, JWT_SECRET, SELFHOST_MODEL
#   docker compose -f docker-compose.selfhost.yml up -d --build
#
# Only the keys below are used by the self-host build. No Stripe, no cloud
# model provider keys (DashScope / DeepSeek / StepFun / MiMo / OpenRouter),
# no TTS or image-generation settings.

# ── Admin account ──
# Created automatically on first start if it does not exist.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Auth ──
# Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# ── Server ──
HOST=0.0.0.0
PORT=8090

# ── Self-host mode ──
# Turns off billing routes and turn caps; the DM plays only on local Ollama.
SELFHOST=1

# ── Local Ollama ──
# Native Ollama API (no /v1 suffix). host.docker.internal reaches an Ollama
# running on the Docker host; use http://localhost:11434 when you run the app
# outside Docker.
OLLAMA_URL=http://host.docker.internal:11434

# Pin the model the DM plays with — the bare Ollama name, no "ollama:" prefix.
# It has to be instruction-following and reliable at producing JSON; 8B is the
# practical minimum.
SELFHOST_MODEL=qwen3:8b

# ── RAG memory (optional) ──
# Leave unset and vector memory stays off. Point it at any reachable Qdrant
# instance (plus an embedding model in Ollama) to switch RAG on.
# QDRANT_URL=http://host.docker.internal:6333